# Production environment template for the Leanbox API (Render).
#
# This mirrors the env group in render.yaml. Values here are placeholders — set
# the real ones as Render env vars (never commit real secrets). Reflects the
# CLAUDE.md stack: database queue/cache/session drivers (NO Redis) and Supabase
# Storage for images (NO Cloudinary).

APP_NAME=Leanbox
APP_ENV=production
APP_KEY=                       # php artisan key:generate --show
APP_DEBUG=false
APP_URL=https://leanbox-api.onrender.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

# Container logging: write to stderr so Render captures it.
LOG_CHANNEL=stderr
LOG_STACK=single
LOG_LEVEL=warning

# PostgreSQL via Supabase. Use the SESSION pooler (port 5432) for the app + worker.
DB_CONNECTION=pgsql
DB_HOST=aws-0-<region>.pooler.supabase.com
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=postgres.<project-ref>
DB_PASSWORD=

# Supabase Storage (S3-compatible) for product/uploaded images. Bucket: leanbox-images.
SUPABASE_ENDPOINT=https://<project-ref>.storage.supabase.co/storage/v1/s3
SUPABASE_ACCESS_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_REGION=ap-southeast-1
SUPABASE_BUCKET=leanbox-images
SUPABASE_PUBLIC_URL=https://<project-ref>.storage.supabase.co/storage/v1/object/public/leanbox-images

# Next.js frontend origin(s) for CORS. Comma-separate multiple. Set to the Vercel URL.
FRONTEND_URL=https://leanbox.vercel.app

# No Redis: cache, queue, and sessions run on the database driver.
SESSION_DRIVER=database
SESSION_LIFETIME=120

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# Transactional email (delivery/order/subscription notifications).
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="hello@leanbox.app"
MAIL_FROM_NAME="${APP_NAME}"
